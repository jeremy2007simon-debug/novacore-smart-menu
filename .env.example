# Copia este archivo a .env.local y rellena los valores de tu proyecto
# Supabase (Project Settings → API). Nunca commitees .env.local — solo este
# .env.example, sin valores reales.

# --- Cliente Supabase (público — expuesto al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Solo servidor: NUNCA con prefijo NEXT_PUBLIC_, nunca al navegador ---
# Usada exclusivamente por lib/supabase/admin.ts (protegido con `server-only`)
# para el panel NovaCore y la futura ingesta de analítica.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# --- Storage (se usa a partir del bloque de subida de imágenes) ---
SUPABASE_STORAGE_BUCKET_PUBLIC=public-assets
SUPABASE_STORAGE_BUCKET_REVIEWS=review-media

# --- Bootstrap del primer superadmin de NovaCore (ver README) ---
NOVACORE_ADMIN_BOOTSTRAP_EMAIL=admin@novacore.example
